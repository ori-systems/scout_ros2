<?xml version="1.0"?>
<robot name="scout_mini_omni_wheel" xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:macro name="scout_mini_omni_wheel" params="wheel_prefix mesh_name axis_xyz *joint_pose">
    <link name="${wheel_prefix}_wheel_link">
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="1.0"/>
        <inertia ixx="0.002288" ixy="0" ixz="0"
                 iyy="0.002890" iyz="0" izz="0.002288"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://scout_description/meshes/scout_mini_omni/${mesh_name}"/>
        </geometry>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
        <geometry>
          <cylinder radius="0.0754335" length="0.0482"/>
        </geometry>
      </collision>
    </link>
    <joint name="${wheel_prefix}_wheel" type="continuous">
      <parent link="base_link"/>
      <child link="${wheel_prefix}_wheel_link"/>
      <xacro:insert_block name="joint_pose"/>
      <axis xyz="${axis_xyz}"/>
    </joint>
  </xacro:macro>
</robot>
