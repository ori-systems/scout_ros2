<?xml version="1.0"?>
<robot name="scout_mini_omni" xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:include filename="$(find scout_description)/urdf/scout_mini/scout_mini_omni_wheel.xacro"/>
  <xacro:property name="wheelbase" value="0.4526"/>
  <xacro:property name="track" value="0.5456008"/>
  <xacro:property name="wheel_vertical_offset" value="-0.096"/>
  <xacro:property name="wheel_radius" value="0.0754335"/>
  <xacro:property name="body_x_size" value="0.5539"/>
  <xacro:property name="body_y_size" value="0.3923"/>
  <xacro:property name="body_z_size" value="0.18235"/>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://scout_description/meshes/scout_mini_omni/chassis.dae"/>
      </geometry>
    </visual>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://scout_description/meshes/scout_mini_omni/front_left_motor.dae"/></geometry>
    </visual>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://scout_description/meshes/scout_mini_omni/front_right_motor.dae"/></geometry>
    </visual>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://scout_description/meshes/scout_mini_omni/rear_left_motor.dae"/></geometry>
    </visual>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://scout_description/meshes/scout_mini_omni/rear_right_motor.dae"/></geometry>
    </visual>

    <!-- Simplified body collision; use a footprint calibrated to the robot for Nav2. -->
    <collision>
      <origin xyz="-0.02132 0 -0.02201" rpy="0 0 0"/>
      <geometry>
        <box size="${body_x_size} ${body_y_size} ${body_z_size}"/>
      </geometry>
    </collision>
  </link>

  <!-- Existing ROS frame names are retained for TF/Nav2 compatibility. -->
  <link name="base_footprint"/>
  <joint name="base_footprint_joint" type="fixed">
    <origin xyz="0 0 ${wheel_vertical_offset - wheel_radius}" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="base_footprint"/>
  </joint>

  <link name="inertial_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="18"/>
      <inertia ixx="0.2779" ixy="0" ixz="0"
               iyy="0.5206" iyz="0" izz="0.6994"/>
    </inertial>
  </link>
  <joint name="inertial_joint" type="fixed">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="inertial_link"/>
  </joint>

  <!-- Separate corner-specific meshes preserve the roller orientation. -->
  <xacro:scout_mini_omni_wheel wheel_prefix="front_left" mesh_name="front_left.dae" axis_xyz="0 -1 0">
    <origin xyz="${wheelbase/2} ${track/2} ${wheel_vertical_offset}" rpy="0 0 0"/>
  </xacro:scout_mini_omni_wheel>
  <xacro:scout_mini_omni_wheel wheel_prefix="front_right" mesh_name="front_right.dae" axis_xyz="0 1 0">
    <origin xyz="${wheelbase/2} ${-track/2} ${wheel_vertical_offset}" rpy="0 0 0"/>
  </xacro:scout_mini_omni_wheel>
  <xacro:scout_mini_omni_wheel wheel_prefix="rear_left" mesh_name="rear_left.dae" axis_xyz="0 -1 0">
    <origin xyz="${-wheelbase/2} ${track/2} ${wheel_vertical_offset}" rpy="0 0 0"/>
  </xacro:scout_mini_omni_wheel>
  <xacro:scout_mini_omni_wheel wheel_prefix="rear_right" mesh_name="rear_right.dae" axis_xyz="0 1 0">
    <origin xyz="${-wheelbase/2} ${-track/2} ${wheel_vertical_offset}" rpy="0 0 0"/>
  </xacro:scout_mini_omni_wheel>

  <!-- Legacy omni mounting frames, useful for fixed sensor transforms. -->
  <link name="front_mount"/>
  <joint name="front_mount_joint" type="fixed">
    <origin xyz="0.175 0 0.069" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="front_mount"/>
  </joint>
  <link name="rear_mount"/>
  <joint name="rear_mount_joint" type="fixed">
    <origin xyz="-0.175 0 0.069" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="rear_mount"/>
  </joint>
</robot>
