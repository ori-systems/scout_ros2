<?xml version="1.0" encoding="UTF-8"?>
<!-- Coloured Scout Mini Omni convenience URDF; source is the Xacro. -->
<robot name="scout_mini_omni">
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://scout_description/meshes/scout_mini_omni/chassis.dae"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="-0.02132 0 -0.02201" rpy="0 0 0"/>
      <geometry>
        <box size="0.5539 0.3923 0.18235"/>
      </geometry>
    </collision>
  <visual><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="package://scout_description/meshes/scout_mini_omni/front_left_motor.dae"/></geometry></visual><visual><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="package://scout_description/meshes/scout_mini_omni/front_right_motor.dae"/></geometry></visual><visual><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="package://scout_description/meshes/scout_mini_omni/rear_left_motor.dae"/></geometry></visual><visual><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="package://scout_description/meshes/scout_mini_omni/rear_right_motor.dae"/></geometry></visual></link>
  <link name="base_footprint"/>
  <joint name="base_footprint_joint" type="fixed">
    <origin xyz="0 0 -0.1714335" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="base_footprint"/>
  </joint>
  <link name="inertial_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="18"/>
      <inertia ixx="0.2779" ixy="0" ixz="0" iyy="0.5206" iyz="0" izz="0.6994"/>
    </inertial>
  </link>
  <joint name="inertial_joint" type="fixed">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="inertial_link"/>
  </joint>
  <link name="front_left_wheel_link">
